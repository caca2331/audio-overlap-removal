# Build image for the portable Linux distribution.
#
#   docker build -t audio-overlap-removal-build:manylinux \
#     -f packaging/Dockerfile.manylinux packaging
#
# The manylinux base is here for its glibc 2.28: binaries linked against it
# also run on newer distributions, which is not true the other way round.
#
# Its bundled interpreters under /opt/python are static builds with no
# libpython.so, which PyInstaller refuses to work with, so the build uses the
# distribution's shared python3.11 instead.
FROM quay.io/pypa/manylinux_2_28_x86_64

RUN dnf install -y python3.11 python3.11-pip python3.11-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf

ENV PYTHON=/usr/bin/python3.11
